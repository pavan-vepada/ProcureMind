# Copy this file to .env.local and fill in the values. .env.local is never committed.

# Supabase → Project Settings → Data API (Project URL) and API Keys (anon / publishable key)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase → Connect (top bar) → "Session pooler" connection string, with your database password filled in.
# Only used on your machine to set up the database tables (npm run db:migrate). Not needed on Vercel.
SUPABASE_DB_URL=

# A real mailbox for automated tests; they sign up throwaway accounts as name+pmtest-xxxx@domain.
# Nothing is emailed while Supabase email confirmation is off.
TEST_EMAIL=

# OpenAI → platform.openai.com → API keys. Needed from build step 3 (reading vendor replies).
OPENAI_API_KEY=
AI_MODEL=
